@charset "utf-8";

* { box-sizing: border-box; }

:root { --main-bg-color: #ffffff; --pre-bg-color: #f9f9f9; --table-bg-color: #f8f9fa; --th-list-logo-bg-color: #eceadf; --input-submit-bg-color: #427E94; --shadow-bg-color: #d9eaef; --main-txt-color: #000000; --table-txt-color: #222; --input-submit-txt-color: #fff; --library-txt-color: #a01f13; --pre-border-color: #2f6fab; --table-border-color: #a2a9b1; --table-alt-border-color: #d9d6c4; --th-list-logo-border-color: #cfcaaf; --menu-search-border-color: #d9d5bf; --hover-visited-color: #654b24; --hover-focus-color: #c7dde3; --input-submit-text-shadow-color: rgba(255, 255, 255, 1); --input-submit-box-shadow-color: rgba(0, 0, 0, 0.57); --input-submit-box-shadow-dims: 0px 5px 40px -10px; font-family: "Open Sans", Helvetica, Arial, sans-serif; font-size: 1em; line-height: 1.5em; letter-spacing: 0.01mm; }

html { height: 100%; overflow-y: scroll; }

body { background-color: var(--main-bg-color); color: var(--main-txt-color); display: flex; flex-direction: column; max-width: 100vw; min-height: 100vh; width: 100%; margin: 0px; }

header { display: flex; flex-direction: column; left: 0px; position: fixed; top: 0px; width: 100%; z-index: 1000; }

h2 { font-size: 130%; text-align: left; }

a { color: var(--main-txt-color); }

a:link { color: currentcolor; text-decoration: none; }

a:visited { color: var(--hover-visited-color); }

a:hover { color: currentcolor; text-decoration: underline; }

a:active { color: currentcolor; }

caption { font-weight: bold; }

dt { margin-bottom: 0.2em; }

dd { margin-bottom: 1em; margin-left: 2em; }

ol { margin: 0px 2em; }

ul { list-style-type: "â€¢"; margin: 0px; padding-left: 10px; }

pre { background-color: var(--pre-bg-color); border: 1px dashed var(--pre-border-color); padding: 1em; }

table { border-collapse: collapse; border-spacing: 0px; empty-cells: show; }

table, td { background-color: var(--table-bg-color); }

table, th, td { color: var(--table-txt-color); margin: 1em 0px; border: 1px solid; }

th { background-color: var(--th-list-logo-bg-color); }

@media (max-width: 1024px) {
  header { position: relative; }
  body { padding-top: 0px; }
}

h1, h2, h3, h4, h5, h6 { scroll-margin-top: 130px; }

@media (max-width: 1024px) {
  h1, h2, h3, h4, h5, h6 { scroll-margin-top: 10px; }
}

@media (max-width: 768px) {
  h1 { padding-bottom: 8px; }
}

@media only screen and (max-width: 750px) {
  body { font-size: 1em; }
}

input[type="submit"] { background: var(--input-submit-bg-color); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 45px; color: var(--input-submit-txt-color); display: inline-block; padding: 6px; text-decoration: none; }

input[type="submit"]:hover { text-shadow: 0px 0px 6px var(--input-submit-text-shadow-color); transition: 0.4s; box-shadow: var(--input-submit-box-shadow-dims)
    var(--input-submit-box-shadow-color); }

input[id^="collapsible"] { display: none; }

.noscreen { display: none; }

.center { text-align: center; }

.right { text-align: right; }

.small { font-size: 70%; }

.narrow { width: 1%; }

.hstrut { clear: both; content: "."; display: block; height: 0px; visibility: hidden; }

.qrcode { display: inline-block; width: 116px; height: 116px; }

.qrcode.qrcode-desktop { background-position: 0px 0px; }

.paypal-button { min-width: 74px; height: 21px; }

.rss-follow-button { height: 20px; }

.h1 { font-weight: bold; }

.icon { display: inline-block; vertical-align: middle; background-image: url("/pics/sprite.png?1591823171"); width: 23px; height: 23px; }

.cell { padding: 0.2em 1.2em; }

.cell.leftcell { float: left; vertical-align: top; }

.cell.leftcell.with-cover { min-width: 105px; }

.cell.content { display: block; padding-left: 1em; color: var(--library-txt-color); }

.cell.content:hover { color: rgb(141, 119, 11); }

.no-hover:hover { text-decoration: none; }

.no-select { user-select: none; }

.container { width: 100%; position: relative; flex: 1 1 0%; }

@media (max-width: 1024px) {
  .container { min-height: 0px; padding: 0px; margin-top: 0px; }
}

@media screen and (orientation: landscape) {
  .container { min-height: 75vh; }
}

@media screen and (orientation: portrait) {
  .container { min-height: 75vh; }
}

@media (max-width: 768px) {
  .summary-text-container { text-align: center; }
}

.library .latest { white-space: nowrap; width: 100%; }

.library .latest::-webkit-scrollbar { height: 3px; }

.library .latest::-webkit-scrollbar-track { background-color: rgb(204, 204, 204); }

.library .latest::-webkit-scrollbar-thumb { background-color: rgb(51, 51, 51); }

.library .latest a { display: inline-block; margin: 0px; padding: 10px; vertical-align: top; }

.library .latest a:hover { background-color: transparent; }

